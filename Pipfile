[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[[source]]
name = "pytorch-cpu"
url = "https://download.pytorch.org/whl/cpu"
verify_ssl = true

[dev-packages]
pylint = "*"
autopep8 = "*"
watchdog = "*"
argh = "*"
pyyaml = "*"

[packages]
flask = "*"
spacy = ">=3.5.0,<3.6.0"
spacytextblob = "*"
psutil = "*"
keybert = {extras = ["spacy"], version = ">=0.8.0,<1.0.0"}
sentence-transformers = ">=2.2.0,<2.3.0"
datasets = ">=2.0.0,<3.0.0"
torch = {version = ">=2.0.0,<3.0.0", source = "pytorch-cpu"}
flask-limiter = "*"
werkzeug = "*"
gunicorn = "*"
redis = "*"
numpy = ">=1.21.0,<2.0.0"
transformers = ">=4.30.0,<4.40.0"
huggingface-hub = ">=0.16.0,<0.20.0"
nltk = ">=3.8.0,<4.0.0"

[requires]
python_version = "3.11"

[scripts]
python = "python"
docker = "docker-compose up"
app = "gunicorn -b :8000 -w 1 --threads 15 --log-level debug application"
flask = "env FLASK_APP=application FLASK_RUN_HOST=0.0.0.0 FLASK_RUN_PORT=8000 flask run"
dev = "watchmedo auto-restart --recursive -p '*.py;*.yaml' env FLASK_APP=application FLASK_DEBUG=1 FLASK_RUN_PORT=8000 TOKENIZERS_PARALLELISM=false flask run"
lint = "pylint application"
download = "./download.sh"
deploy = "eb deploy"
