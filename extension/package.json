{
  "name": "extension",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon",
    "ext:dev": "shx rm -Rf build && shx mkdir -p build && GIT_TAGS=$(git describe --always --tags --dirty=-dev) NODE_ENV=development webpack --mode=development --watch --progress --config webpack.config.js",
    "ext:build": "shx mkdir -p dist && GIT_TAGS=$(git describe --always --tags --dirty=-dev) NODE_ENV=production webpack --mode=production --config webpack.config.js --json=extension-stats.json; web-ext build -s build -a dist",
    "ext:run": "export PLATFORM=$(node -e 'console.info(process.platform)'); npm run ext:run:${PLATFORM}",
    "ext:run:darwin": "/Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --load-extension=${PWD}/build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@headlessui/react": "^1.7.3",
    "@heroicons/react": "^2.0.12",
    "@mozilla/readability": "^0.5.0",
    "node-fetch": "^2.7.0",
    "openai": "^4.28.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^5.3.6",
    "webextension-polyfill": "^0.10.0",
    "whatwg-url": "^14.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.19.1",
    "@babel/preset-env": "^7.19.4",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@types/node": "^18.11.0",
    "@types/react-dom": "^18.0.6",
    "@types/styled-components": "^5.1.26",
    "@types/webextension-polyfill": "^0.9.1",
    "autoprefixer": "^10.4.12",
    "babel-loader": "^8.2.5",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "dotenv": "^16.0.3",
    "nodemon": "^2.0.22",
    "postcss": "^8.4.18",
    "postcss-import": "^15.0.0",
    "postcss-loader": "^7.0.1",
    "prettier": "^2.7.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.55.0",
    "sass-loader": "^13.1.0",
    "shx": "^0.3.4",
    "style-loader": "^3.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^4.8.4",
    "url-loader": "^4.1.1",
    "web-ext": "^7.11.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "overrides": {
    "whatwg-url": "^14.0.0"
  }
}
